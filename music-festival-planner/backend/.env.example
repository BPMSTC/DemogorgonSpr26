# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# MongoDB connection string
# Local:  mongodb://localhost:27017/music-festival-planner
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/music-festival-planner
MONGODB_URI=mongodb://localhost:27017/music-festival-planner

# Port the Express server listens on
PORT=3000

# Optional comma-separated allowlist for CORS origins.
# Leave empty to allow all origins (development default).
CORS_ALLOWED_ORIGINS=http://localhost:4200
