# Copy this file to .env and fill in your Atlas values.
# NEVER commit local env files to version control.

# MongoDB connection string
# Atlas: see .env.atlas.example
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/music-festival-planner?retryWrites=true&w=majority&appName=Cluster0

# Optional DNS fallback for networks that block SRV lookups on system DNS.
# Comma-separated list. Leave as-is unless your network requires a different resolver.
MONGODB_DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8

# Port the Express server listens on
PORT=3000

# Optional comma-separated allowlist for CORS origins.
# Leave empty to allow all origins (development default).
CORS_ALLOWED_ORIGINS=http://localhost:4200

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.events
CALENDAR_FRONTEND_SUCCESS_URL=http://localhost:4200/#/my-schedule
CALENDAR_FRONTEND_ERROR_URL=http://localhost:4200/#/my-schedule
