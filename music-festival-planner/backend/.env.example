# Copy this file to .env.local and fill in your values.
# NEVER commit local env files to version control.

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/music-festival-planner-dev
# Atlas:  see .env.atlas.example
MONGODB_URI=mongodb://127.0.0.1:27017/music-festival-planner-dev

# Port the Express server listens on
PORT=3000

# Optional comma-separated allowlist for CORS origins.
# Leave empty to allow all origins (development default).
CORS_ALLOWED_ORIGINS=http://localhost:4200
