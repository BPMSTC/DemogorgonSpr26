# Atlas MongoDB connection string
# Replace <username>, <password>, and <cluster-url> with your Atlas values.
# Example cluster-url: cluster0.abcde.mongodb.net
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/music-festival-planner?retryWrites=true&w=majority&appName=Cluster0

# Port the Express server listens on
PORT=3000

# Optional comma-separated allowlist for CORS origins.
# Leave empty to allow all origins (development default).
CORS_ALLOWED_ORIGINS=http://localhost:4200
