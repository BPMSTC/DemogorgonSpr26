{
  "name": "music-festival-planner-backend",
  "version": "1.0.0",
  "description": "Express/MongoDB backend API for the Music Festival Planner",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "seed:local": "node -e \"process.env.MONGODB_ENV_FILE='.env.local'; require('./scripts/seed');\"",
    "seed:atlas": "node -e \"process.env.MONGODB_ENV_FILE='.env.atlas'; require('./scripts/seed');\"",
    "seed:reset": "node scripts/seed.js --reset --confirm WIPE",
    "mongo:check": "node scripts/check-mongo.js",
    "mongo:check:local": "node -e \"process.env.MONGODB_ENV_FILE='.env.local'; require('./scripts/check-mongo');\"",
    "mongo:check:atlas": "node -e \"process.env.MONGODB_ENV_FILE='.env.atlas'; require('./scripts/check-mongo');\"",
    "migrate": "node migrate.js",
    "use-local-db": "node -e \"require('fs').copyFileSync('.env.local','.env'); console.log('Switched to local MongoDB (.env.local -> .env)');\"",
    "use-atlas-db": "node -e \"require('fs').copyFileSync('.env.atlas','.env'); console.log('Switched to Atlas MongoDB (.env.atlas -> .env)');\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.2",
    "joi": "^18.1.2",
    "mongoose": "^8.23.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
