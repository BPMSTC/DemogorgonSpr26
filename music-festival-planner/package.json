{
  "name": "music-festival-planner",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:backend": "npm --prefix backend start",
    "dev": "concurrently --kill-others-on-fail --names \"API,NG\" --prefix-colors \"cyan,magenta\" \"npm run start:backend\" \"npm run start\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:backend": "npm --prefix backend exec -- node --test tests",
    "seed": "node backend/scripts/seed.js",
    "seed:local": "node -e \"process.env.MONGODB_ENV_FILE='backend/.env.local'; require('./backend/scripts/seed');\"",
    "seed:atlas": "node -e \"process.env.MONGODB_ENV_FILE='backend/.env.atlas'; require('./backend/scripts/seed');\"",
    "seed:reset": "node backend/scripts/seed.js --reset --confirm WIPE",
    "mongo:check": "node backend/scripts/check-mongo.js",
    "mongo:check:local": "node -e \"process.env.MONGODB_ENV_FILE='backend/.env.local'; require('./backend/scripts/check-mongo');\"",
    "mongo:check:atlas": "node -e \"process.env.MONGODB_ENV_FILE='backend/.env.atlas'; require('./backend/scripts/check-mongo');\""
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.4.2",
    "mongoose": "^9.4.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "concurrently": "^9.1.2",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@vitest/coverage-v8": "^4.1.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
